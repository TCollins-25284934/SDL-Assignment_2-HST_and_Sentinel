EXPEND  =                   0. / exposure end time (Modified Julian Date)       EXPTIME =                   0. / exposure duration (seconds)--calculated        EXPFLAG = '''      '           / Exposure interruption indicator                QUALCOM1= '        '                                                            QUALCOM2= '        '                                                            QUALCOM3= '        '                                                            QUALITY = '        '                                                                                                                                                          / TARGET & PROPOSAL ID                                            TARGNAME= 'DARK    '           / proposer's target name                         RA_TARG =   0.000000000000E+00 / right ascension of the target (deg) (J2000)    DEC_TARG=   0.000000000000E+00 / declination of the target (deg) (J2000)        ECL_LONG=           317.067188 / ecliptic longitude of the target (deg) (J2000) ECL_LAT =           -64.450592 / ecliptic latitude of the target (deg) (J2000)  GAL_LONG=           301.536917 / galactic longitude of the target (deg) (J2000) GAL_LAT =           -46.254021 / galactic latitude of the target (deg) (J2000)                                                                                  PROPOSID= '11302   '           / PEP proposal identifier                        PEP_EXPO= '        '           / PEP exposure identifier including sequence     LINENUM = '0.      '           / PEP proposal line number                       SEQLINE = '0.      '           / PEP line number of defined sequence            SEQNAME = '''      '           / PEP define/use sequence name                                                                                                                                                                                                 / OTFR KEYWORDS                                                                                                                                   T_SGSTAR= '        '           / OMS calculated guide star control                                                                                                            / PATTERN KEYWORDS                                                                                                                                PATTERN1= 'NONE    '           / primary pattern type                           P1_SHAPE= '        '           / primary pattern shape                          P1_PURPS= '        '           / primary pattern purpose                        P1_NPTS =                    0 / number of points in primary pattern            P1_PSPAC=             0.000000 / point spacing for primary pattern (arc-sec)    P1_LSPAC=             0.000000 / line spacing for primary pattern (arc-sec)     P1_ANGLE=             0.000000 / angle between sides of parallelogram patt (deg)P1_FRAME= '        '           / coordinate frame of primary pattern            P1_ORINT=             0.000000 / orientation of pattern to coordinate frame (degP1_CENTR= '        '           / center pattern relative to pointing (yes/no)   PATTSTEP=                    0 / position number of this point in the pattern   USEAFTER= 'Mar 16 2009 03:24:12'                                                PEDIGREE= 'INFLIGHT 16/03/2009'                                                 DESCRIP = 'Pipeline dark: 120 frame superdark with hotpixels from 16/03/2009'   COMMENT = 'Weekly pipeline dark created by M. McMaster and P.L. Lim'            HISTORY   This is a PIPELINE WEEKLY DARK FILE.                                  HISTORY   It was created using a SUPERDARK, which was created                   HISTORY   from an average of 120 input darks.  The input                        HISTORY   darks were from the date range of Jan 1 2008, through                 HISTORY   Feb 22 2009, and consisted of the following files:                    HISTORY                                                                         HISTORY   u9uj7p01m u9uj7w01m u9uj7x01m u9uj7y01m u9uj7z01m                     HISTORY   u9uj9f01m u9uj9g01m u9uj9h01m u9uj9i01m u9uj9j01m                     HISTORY   u9uj9r01m u9uj9y01m u9uj9z01m u9uja301m u9uja401m                     HISTORY   u9uja601m u9uja701m u9uja901m u9ujad01m u9ujaf01m                     HISTORY   u9ujag01m u9ujao01m u9ujar01m u9ujay01m u9ujaz01m                     HISTORY   u9ujb101m u9ujb301m u9ujb701m u9ujbf01m u9ujbg01m                     HISTORY   u9ujbh01m u9ujbi01m u9ujbj01m u9ujbl01m u9ujbm01m                     HISTORY   u9ujbn01m u9ujbo01m u9ujbs01m u9ujbv01m u9ujbx01m                     HISTORY   u9ujby01m u9ujc101m u9ujc401m u9ujc501m u9ujc701m                     HISTORY   u9ujc901m u9ujca01m u9ujcd01m u9ujcj01m u9ujcm01m                     HISTORY   u9ujcn01m u9ujcv01m u9ujd101m u9ujd301m u9ujd501m                     HISTORY   u9ujd601m u9ujd701m u9ujd901m u9ujdb01m u9unh301m                     HISTORY   u9unh303m u9unh304m u9unh305m u9unha01m u9unia01m                     HISTORY   u9unia03m u9unia04m u9unia05m u9unj304m u9unja02m                     HISTORY   u9unka04m u9unka05m u9wj7401m ub0pl304m ub0pm301m                     HISTORY   ub0pm302m ub0pm305m ub0pma01m ub0pmi01m ub0pmm01m                     HISTORY   ub0pmm02m ub0pn302m ub0po301m ub0po303m ub0po304m                     HISTORY   ub0po305m ub0poa02m ub0pp303m ub0ppa01m ub0u0101m                     HISTORY   ub0u0201m ub0u0501m ub0u0h01m ub0u0l01m ub0u0m01m                     HISTORY   ub0u0p01m ub0u0q01m ub0u0t01m ub0u0w01m ub0u0x01m                     HISTORY   ub0u0y01m ub0u0z01m ub0u1701m ub0u1h01m ub0u1n01m                     HISTORY   ub0u1q01m ub0u2801m ub0u2901m ub0u2d01m ub0u2f01m                     HISTORY   ub0u2h01m ub0u2j01m ub0u2m01m ub0u2n01m ub0u2p01m                     HISTORY   ub0u3101m ub0u3301m ub0u3501m ub0u7301m ub0u7601m                     HISTORY                                                                         HISTORY   All the datasets were calibrated using CALWP Version 2.5.3,           HISTORY   utilizing the most up-to-date reference files, including              HISTORY   the new superbias (t3r19020). Only images with WF4                    HISTORY   BIASEVEN > 295 were used, so as to avoid large gain                   HISTORY   corrections.                                                          HISTORY                                                                         HISTORY   Cosmic rays and their CTE trails were removed and the images          HISTORY   were combined in sets of 40, using mkdark. The resulting 3            HISTORY   images were combined to create the final superdark file,              HISTORY   which was normalized to an exposure time of 1.0 second.               HISTORY   Mkdark parameters used for combining the images                       HISTORY   were:                                                                 HISTORY                                                                         HISTORY   sigmas = 10,10,8,6,5,4,3                                              HISTORY   radius = 1.5                                                          HISTORY   pfactor = 0.5                                                         HISTORY   hotthres= 4096.                                                       HISTORY   minval = 0.                                                           HISTORY   initial = min                                                         HISTORY                                                                         HISTORY   The associated DQF file was computed in the following manner:         HISTORY   If more than 60 of the 120 input files are valid and the dark         HISTORY   current is <= 0.02 DN/s, then the pixel value is 0 (valid data).      HISTORY   If more than 60 input files are valid and the dark current            HISTORY   is > 0.02 DN/s, then the pixel value is 512 (uncorrectable            HISTORY   warm pixel).                                                          HISTORY                                                                         HISTORY   Warm pixels (>0.00155 DN) that are also variable (<98.5 images        HISTORY   used by mkdark) are flagged as uncorrectable (512).                   HISTORY   Measure the variation between the three sets of 40 images,            HISTORY   and flag the pixel as uncorrectable (512) if the variation            HISTORY   exceeds approximately 3 times that expected from noise.               HISTORY   If <= 60 input files are valid, set the pixel value to the            HISTORY   "bitwise-OR" of all input masks (any flag set in any of the           HISTORY   input files is set on the mask).                                      HISTORY                                                                         HISTORY   If none of the input files are valid, set the pixel value to          HISTORY   the "bitwise-AND" of all input masks (bad pixel).                     HISTORY                                                                         HISTORY   The files used in the WEEKLY update portion of the dark are:          HISTORY   ub0u3p01m   ub0u3q01m   ub0u3r01m   ub0u3s01m   ub0u3t01m             HISTORY                                                                         HISTORY   The mean of this resultant weekly dark, excluding values deviating    HISTORY   by more than 3*sigma, was saved to a file, with one mean value for    HISTORY   each chip. This was done for 3 iterations and the final means and     HISTORY   sigmas were used in conjunction with the weekly dark and the          HISTORY   superdark, to generate the pipeline dark: each pixel was compared     HISTORY   to the chip statistics, to determine whether it exceeded a            HISTORY   threshold based on average and sigma.                                 HISTORY                                                                         HISTORY   That is, if abs value(weekly dark-superdark) > 5*sigma then           HISTORY   pixel value of weekly is used in the pipeline dark. If the            HISTORY   pixel value of the weekly dark did not exceed the threshold,          HISTORY   the pixel value of superdark is used for the pipeline dark.           HISTORY                                                                         HISTORY   The values of 5*sigma used to make this dark are (for the PC,         HISTORY   WF2, WF3, and WF4, respectively):                                     HISTORY   0.001679                                                              HISTORY   0.0014515                                                             HISTORY   0.001647                                                              HISTORY   0.0015855                                                             HISTORY                                                                         HISTORY   (Files created using the STSDAS MKDARK task at                        HISTORY   STScI,  2 Jul 2009)                                                   HISTORY                                                                         HISTORY   The values in the pipeline dark DQF (*.b3h) reflect whether a pixel   HISTORY   value comes from the weekly dark or from the superdark, and whether itHISTORY   has changed recently. That is, the following values are used:         HISTORY                                                                         HISTORY   2 if pixel came from weekly dark and was generated from 3 or less     HISTORY     of the 5 input frames for that week                                 HISTORY                                                                         HISTORY   512 if the pixel value comes from the weekly dark, and did vary       HISTORY       substantially with respect to the previous week's pipeline dark   HISTORY       (an "unfixable" pixel in stsdas task warmpix).                    HISTORY                                                                         HISTORY   1024 if the pixel value comes from the weekly dark, and did not vary  HISTORY        substantially with respect to the value in the previous week     HISTORY        (considered a "fixable" pixel in warmpix).                       HISTORY                                                                         HISTORY   Calwp2 will bit-wise OR any pipeline DARK DQF values with the values  HISTORY   from any of the other DQF files used in the calibration processing andHISTORY   place results in c1h file.                                            HISTORY                                                                         HISTORY   ATODGAIN 15 darks were created by multiplying the                     HISTORY   corresponding ATODGAIN 7 dark by 0.5.                                 HISTORY                                                                         HISTORY   ndark15.r3h renamed to t721745gu.r3h on Jul 2 2009                    CTYPE3  = 'GROUP_NUMBER'       / Extra dimension axis name                      CD3_3   =                    1 /                                                CD3_1   =                    0 /                                                CD1_3   =                    0 /                                                CD2_3   =                    0 /                                                CD3_2   =                    0 /                                                END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             :-9ý[9‰a9Ã$ó9¾|9¼+<9Çu29›ÇŽ9º¥9¨m9ŽÝ9¶§69¼õ)9½¿9À‰9‘¿9Õ…Y9—nP9ø3&:j9í*¯9Ôxü9±v{:¤0>9Áœµ9ìÐ·9°S¹9·¸÷9•A˜9­.‹9µ­9õ£9°$9É;z9ÜÀ‡9•S9¯gt:BÁ€9ÁÜü9ÒŸd9¶Q?9Úó9à¤<9Ãˆ—;LÅY9ÌzD9Æª89»wÝ9Ã¯L9Þ‹ 9¸²:
